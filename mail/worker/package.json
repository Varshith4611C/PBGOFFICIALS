{
  "name": "pbg-mail-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create pbg-mail-db",
    "db:migrate": "wrangler d1 execute pbg-mail-db --file=schema.sql --remote",
    "db:migrate:local": "wrangler d1 execute pbg-mail-db --file=schema.sql --local",
    "r2:create": "wrangler r2 bucket create pbg-mail-store",
    "queue:create": "wrangler queues create pbg-mail-inbound",
    "queue:dlq": "wrangler queues create pbg-mail-dlq"
  },
  "dependencies": {
    "postal-mime": "^2.4.1"
  }
}
